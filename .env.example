PORT=3005

# Database Configuration (Optional locally - supports TiDB Cloud MySQL, PostgreSQL, or Local fallback)
# Example TiDB MySQL URL: mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/whatsapp_db
# Or PostgreSQL URL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# Optional individual DB credentials for TiDB Cloud / MySQL
DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=whatsapp_db

# Google Client ID for Official Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Multi-User & Demo Authentication Configuration
ADMIN_EMAIL=admin.demo@gmail.com
ADMIN_PASSWORD=YourAdminPasswordHere123!
DEMO_USER_EMAIL=user.demo@gmail.com
DEMO_USER_PASSWORD=YourUserPasswordHere123!
DEMO_OTP=123456
JWT_SECRET=your_jwt_secret_key_here

# Optional SMTP Settings for Live Email OTP (if empty, OTP is logged to console and displayed in UI demo banner)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cortex WA AutoBot" <noreply@cortex-autobot.com>

# Live UPI QR Payment Configuration (Auto-generates dynamic QR code based on this UPI ID)
PAYMENT_UPI_ID=your_upi_id@bank
PAYMENT_PAYEE_NAME=Cortex WA AutoBot
